# Database
# ВАЖНО: если в URL порт :5432 на *.pooler.supabase.com — это session mode, там жёсткий лимит
# одновременных клиентов (у нас на практике оказалось 15 — см. DB_POOL_MAX ниже). Под реальной
# нагрузкой лучше transaction-mode pooler (:6543, тот же хост) — там коннекты мультиплексируются,
# лимит намного мягче. Прямое подключение (db.*.supabase.co:5432, без pooler) — тоже вариант
# для одного инстанса, но также ограничено лимитом самой БД.
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Облако недоступно и ставить ничего не хочется — `npm run dev:offline`:
# база (PGlite) и сервер поднимутся одной командой, этот файл для этого
# режима не обязателен. Подробности — в scripts/dev-offline.mjs.
#
# База на СВОЁМ компьютере (например, если облако временно недоступно):
# PostgreSQL с postgresql.org/download/windows, пароль — тот, что задали при
# установке, базу создать заранее (createdb -U postgres booster). Дальше
# npm run migrate и npm run seed — таблицы и расширения создадутся сами.
# DATABASE_URL=postgresql://postgres:ПАРОЛЬ@localhost:5432/booster

# SSL к базе. По умолчанию: для localhost выключен (локальный PostgreSQL его
# обычно не поддерживает), для всех остальных адресов включён. Переопределить
# при необходимости: DB_SSL=false / DB_SSL=true
# DB_SSL=

# JWT — сгенерируй уникальные случайные строки, например: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_generate_a_random_64_char_secret
# 30d — дети не проходят силент-рефреш вовремя и не помнят пароли, поэтому сессия держится долго сама по себе
JWT_EXPIRES_IN=30d
REFRESH_TOKEN_SECRET=change_me_generate_another_random_64_char_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# Server
PORT=3000
NODE_ENV=development
# Только для production: домены фронтенда через запятую, без этого CORS в проде заблокирует все запросы
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Admin
ADMIN_SECRET_KEY=change_me_generate_a_random_secret

# App
DB_POOL_MAX=10
ENTRY_BONUS_FOX=200
QUIZ_CORRECT_FOX_REWARD=20
QUIZ_WRONG_FOX_REWARD=0
QUIZ_CORRECT_EXP_REWARD=50
QUIZ_WRONG_EXP_REWARD=10
DAILY_GAMES_FOX_LIMIT=100
